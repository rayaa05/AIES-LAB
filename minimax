import math

def print_board(b):
    for r in b:
        print(r)
    print()

def check(b):
    for i in range(3):
        if b[i][0]==b[i][1]==b[i][2]!=" ": return b[i][0]
        if b[0][i]==b[1][i]==b[2][i]!=" ": return b[0][i]
    if b[0][0]==b[1][1]==b[2][2]!=" ": return b[0][0]
    if b[0][2]==b[1][1]==b[2][0]!=" ": return b[0][2]
    for r in b:
        if " " in r: return None
    return "Draw"

def minimax(b, isMax):
    res = check(b)
    if res=="X": return -1
    if res=="O": return 1
    if res=="Draw": return 0

    best = -math.inf if isMax else math.inf

    for i in range(3):
        for j in range(3):
            if b[i][j]==" ":
                b[i][j] = "O" if isMax else "X"
                val = minimax(b, not isMax)
                b[i][j] = " "
                best = max(best,val) if isMax else min(best,val)
    return best

def best_move(b):
    best = -math.inf
    move = (0,0)
    for i in range(3):
        for j in range(3):
            if b[i][j]==" ":
                b[i][j]="O"
                val = minimax(b, False)
                b[i][j]=" "
                if val>best:
                    best=val
                    move=(i,j)
    return move

b = [[" "]*3 for _ in range(3)]

while True:
    print_board(b)

    r = int(input("row(0-2): "))
    c = int(input("col(0-2): "))
    if b[r][c]!=" ":
        continue

    b[r][c]="X"

    if check(b):
        break

    i,j = best_move(b)
    b[i][j]="O"

    if check(b):
        break

print_board(b)
print("Result:", check(b))